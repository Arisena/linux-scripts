#!/usr/bin/env bash
# cleanorphans — remove pacman orphans and unused flatpak runtimes.
# An "orphan" is a package installed as a dependency that nothing requires anymore.

set -uo pipefail

print_orphans() {
    local -a orphans
    mapfile -t orphans < <(pacman -Qtdq)
    if ((${#orphans[@]} == 0)); then
        echo "No orphans found."
        return 1
    fi
    echo "Orphans (${#orphans[@]}):"
    pacman -Qdt "${orphans[@]}"
    return 0
}

remove_orphans() {
    local -a orphans
    mapfile -t orphans < <(pacman -Qtdq)
    if ((${#orphans[@]} == 0)); then
        echo "No orphans found."
        return 0
    fi
    echo "The following ${#orphans[@]} package(s) will be removed:"
    pacman -Qdt "${orphans[@]}"
    echo
    read -rp "Proceed? [y/N] " reply
    if [[ ${reply,,} != "y" ]]; then
        echo "Aborted."
        return 0
    fi
    sudo pacman -Rns "${orphans[@]}"
}

while true; do
    cat <<'EOF'
CleanOrphans
  1) List and remove pacman orphans
  2) Show "not required" packages (report only, no removal)
  3) Remove unused flatpak runtimes
  4) Exit
EOF
    read -rp "Choice: " choice
    echo
    case $choice in
        1) remove_orphans ;;
        2)
            echo "Packages installed as dependencies that nothing explicitly requires:"
            echo "(Report only — this includes optional dependencies of packages you use.)"
            echo
            pacman -Qqd | pacman -Rsu --print - 2>/dev/null | sed -n '/^Packages (/,$p'
            ;;
        3) flatpak uninstall --unused ;;
        4) exit 0 ;;
        *) echo "Invalid choice." ;;
    esac
    echo
done
